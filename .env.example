# Required — get these from your Supabase project dashboard → Settings → API

# Supabase public URL and anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase service role key (NEVER expose this on the client side)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Prisma / PostgreSQL
# Get from Supabase → Settings → Database → Connection string (URI mode)
# Append ?pgbouncer=true&connection_limit=1 for serverless environments
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection for Prisma migrations (port 5432, no pgbouncer)
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Seed: email address to promote to super_admin on first run
SUPER_ADMIN_EMAIL=admin@yourdomain.com
